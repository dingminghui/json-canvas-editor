{
  "name": "json-canvas-editor",
  "version": "0.0.0",
  "description": "一个基于 React、Konva 与 shadcn/ui 的可视化模板编辑器",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host --mode develop",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint:tsc": "tsc -b",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --max-warnings 0 --fix",
    "lint:style": "stylelint \"**/*.css\"",
    "lint:style:fix": "stylelint \"**/*.css\" --fix",
    "lint": "pnpm run lint:tsc && pnpm run lint:eslint && pnpm run lint:style",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:style:fix",
    "format": "prettier --write .",
    "validate": "pnpm run lint && pnpm run test:ci"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/basic-styles": "53.0.0",
    "@platejs/floating": "53.0.0",
    "@platejs/markdown": "53.2.2",
    "@udecode/cn": "52.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dnd-kit-sortable-tree": "^0.1.73",
    "konva": "^10.3.0",
    "lucide-react": "^1.25.0",
    "marked": "15.0.12",
    "platejs": "53.2.4",
    "radix-ui": "^1.6.4",
    "react": "^19.2.0",
    "react-colorful": "5.8.0",
    "react-dom": "^19.2.0",
    "react-konva": "^19.2.5",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "4.0.1",
    "render-tag": "0.1.26",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-image": "^1.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.13",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.0.10",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.13"
  }
}
